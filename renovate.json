{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 3am on Monday"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": [
        "(?:^|\\r?\\n)[A-Z][A-Z0-9_]*_VERSION=(?<currentValue>[^\\s#]+)[ \\t]+#[ \\t]*(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Do not auto-merge - manual review recommended",
      "matchDatasources": ["github-releases"],
      "automerge": false
    },
    {
      "description": "Group Kubernetes core and sigs tools",
      "groupName": "Kubernetes Core & SIGs",
      "schedule": ["before 3am on Monday"],
      "matchPackageNames": [
        "/^kubernetes(-sigs)?//"
      ]
    },
    {
      "description": "Group Infrastructure and Platform tools",
      "groupName": "Infrastructure Tools",
      "schedule": ["before 3am on Monday"],
      "matchPackageNames": [
        "/^(fluxcd|cilium)//"
      ]
    }
  ]
}
